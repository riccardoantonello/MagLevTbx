%implements "sfun_MagLevTbx_MagSens_v44" "C"

%function BlockTypeSetup(block, system) void

    %openfile buffer
    extern void sfun_MagLevTbx_MagSens_v44_WrappedBusStart(void);
    extern void sfun_MagLevTbx_MagSens_v44_WrappedStart(uint8_T sensorId);
    extern void sfun_MagLevTbx_MagSens_v44_WrappedOutput(uint8_T sensorId, double *y0);
    extern void sfun_MagLevTbx_MagSens_v44_WrappedTerminate(void);
    %closefile buffer
    %<LibCacheFunctionPrototype(buffer)>

%endfunction %% BlockTypeSetup


%function Start(block, system) Output

    %assign sensorId = SFcnParamSettings.sensorId
    %assign bus_initFlag = "magSensV44Bus_initFlag"
    %assign sensor_initFlag = "magSensV44Sensor%<sensorId>_initFlag"

    %%  Check if the sensor SPI bus has been initialized
    %if !ISFIELD(::CompiledModel, bus_initFlag)
        %%  If not, set the flag and initialize the bus
        %assign dummy = SETFIELD(::CompiledModel, bus_initFlag, TLC_TRUE)
        /*  Initialize mag sensors SPI bus (deselect all sensors)  */
        sfun_MagLevTbx_MagSens_v44_WrappedBusStart();
    %endif

    %%  Check if the specified magnetic sensor has been initialized
    %if !ISFIELD(::CompiledModel, sensor_initFlag)
        %%  If not, set the flag and initialize the sensor
        %assign dummy = SETFIELD(::CompiledModel, sensor_initFlag, TLC_TRUE)
        /* %<Type> Block: %<Name> */

        /*  Initialize mag sensor %<sensorId>  */
        sfun_MagLevTbx_MagSens_v44_WrappedStart(%<sensorId>);
    %endif

%endfunction %% Start


%function Enable(block, system) Output
    /* %<Type> Block: %<Name> */

%endfunction %% Enable


%function Outputs(block, system) Output
    /* %<Type> Block: %<Name> */
    %assign sensorId = SFcnParamSettings.sensorId
    %assign py0 = LibBlockOutputSignalAddr(0, "", "", 0)

    /*  Get measurement of mag sensor %<sensorId>  */
    sfun_MagLevTbx_MagSens_v44_WrappedOutput(%<sensorId>, %<py0>);

%endfunction %% Outputs


%function Disable(block, system) Output
    /* %<Type> Block: %<Name> */

%endfunction %% Disable


%function Terminate(block, system) Output

    /* %<Type> Block: %<Name> */
    sfun_MagLevTbx_MagSens_v44_WrappedTerminate();

%endfunction %% Terminate
